{
  "description": "Zen is a modern privacy-focused fork of Firefox with built-in uBlock Origin and Dark Reader, a dark theme and DuckDuckGo as the default search engine.",
  "docker_registry": "https://ghcr.io",
  "image_src": "zen.svg",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Browser"
  ],
  "friendly_name": "Zen",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "ghcr.io/ataraxiasjel/kasm-zen:1.19.0-rolling-weekly",
      "uncompressed_size_mb": 3251,
      "available_tags": [
        "rolling-weekly",
        "1.19.0-rolling-weekly"
      ]
    }
  ]
}
